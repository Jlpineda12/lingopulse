{
  "cli": {
    "version": ">= 12.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "development"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "",
        "EXPO_PUBLIC_APP_KEY": ""
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "",
        "EXPO_PUBLIC_APP_KEY": "",
        "EXPO_PUBLIC_SUPPORT_EMAIL": ""
      }
    }
  },
  "submit": {
    "production": {}
  }
}
