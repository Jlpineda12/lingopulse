{
  "expo": {
    "name": "LingoPulse",
    "slug": "lingopulse",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.joses.lingopulse",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "LingoPulse usa el micrófono para grabar tu voz y corregir tu pronunciación en inglés.",
        "NSLocalNetworkUsageDescription": "LingoPulse se conecta al servidor de IA de tu Mac en la red Wi-Fi de casa para corregir tus respuestas.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        },
        "ITSAppUsesNonExemptEncryption": false
      },
      "appleTeamId": "SN636Q8VGB"
    },
    "android": {
      "package": "com.joses.lingopulse",
      "permissions": [
        "RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#7FDBF8"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "icon": "./assets/icon.png",
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "LingoPulse usa el micrófono para grabar tu voz y corregir tu pronunciación en inglés.",
          "enableBackgroundPlayback": false
        }
      ],
      "./plugins/withoutPushEntitlement"
    ]
  }
}
