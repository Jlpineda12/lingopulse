# ==========================================================
# LINGOPULSE — CONFIGURACIÓN DE ENTORNO (.env.example)
# ==========================================================
# IMPORTANTE: El cliente móvil NUNCA recibe claves secretas
# (SUPABASE_SERVICE_ROLE_KEY, DEEPGRAM_API_KEY, GEMINI_API_KEY).
# Esas claves viven únicamente en apps/api.

# --- Backend Orchestrator (apps/api) ---
PORT=4000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Proveedores de Voz e IA (opcionales en desarrollo; usa adaptador determinista si están vacíos)
STT_PROVIDER=mock          # mock | deepgram (transcribe lo que grabas en el teléfono con Expo Go)
DEEPGRAM_API_KEY=
LLM_PROVIDER=mock          # mock | anthropic (coach de corrección con Claude en /api/coach/feedback)
ANTHROPIC_API_KEY=         # solo backend; también sirve un perfil de `ant auth login`
GEMINI_API_KEY=
TTS_PROVIDER=client        # client | elevenlabs | azure

# --- Mobile App (apps/mobile) ---
# Opcional: la app detecta sola la IP del Mac; ponla solo si usas otra máquina para el backend
# EXPO_PUBLIC_API_URL=http://192.168.1.10:4000
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
