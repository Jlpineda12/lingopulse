# ==========================================================
# LINGOPULSE — CONFIGURACIÓN DE ENTORNO (.env.example)
# ==========================================================
# IMPORTANTE: El cliente móvil NUNCA recibe claves secretas
# (SUPABASE_SERVICE_ROLE_KEY, GEMINI_API_KEY, AZURE_SPEECH_KEY, ANTHROPIC_API_KEY).
# Esas claves viven únicamente en apps/api.

# --- Backend Orchestrator (apps/api) ---
PORT=4000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Clave privada de TU app: el servidor solo responde a peticiones que la traigan.
# Inventa una larga (p. ej. con `openssl rand -hex 24`) y pon la MISMA en EXPO_PUBLIC_APP_KEY.
APP_ACCESS_KEY=
# En producción (NODE_ENV=production) el servidor NO arranca sin APP_ACCESS_KEY.
# ALLOW_OPEN_API=1           # solo si de verdad quieres un servidor abierto
# Límite de peticiones por IP y minuto (rutas de IA / resto)
RATE_LIMIT_AI_PER_MIN=30
RATE_LIMIT_PER_MIN=240

# Corrección de Writing y Speaking (elige uno; si falla o no hay clave, se usa el motor local)
LLM_PROVIDER=gemini        # gemini (barato, nivel gratuito) | anthropic (Claude) | mock
GEMINI_API_KEY=            # https://aistudio.google.com/apikey  (aparte de tu suscripción de Google)
GEMINI_MODEL=              # opcional; por defecto gemini-flash-latest
GEMINI_COACH_MODEL=        # opcional; gemini-flash-lite-latest = correcciones ~3x más rápidas pero menos precisas
ANTHROPIC_API_KEY=         # solo si LLM_PROVIDER=anthropic

# Voz: pronunciación por palabra y por sonido + transcripción (Azure AI Speech, plan Free F0)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=       # p. ej. eastus
# Con la misma clave, la mascota habla con voz neuronal alegre (SSML, estilo cheerful).
# Voces opcionales (deben admitir estilos expresivos):
AZURE_TTS_VOICE_US=        # por defecto en-US-JennyNeural
AZURE_TTS_VOICE_GB=        # por defecto en-GB-SoniaNeural
AZURE_CONCURRENCY=1        # plan gratuito F0 = 1; con S0 pon 4 y el habla larga se evalúa más rápido
# Transcripción rápida con Gemini mientras la pronunciación se calcula en paralelo (0 = desactivar)
GEMINI_FAST_TRANSCRIPT=1
GEMINI_STT_MODEL=          # opcional; por defecto gemini-flash-lite-latest (rápido y con cupo propio)
FFMPEG_TIMEOUT_MS=30000
# Sin Azure, el audio se transcribe con Gemini (sin puntaje fonético). Deepgram sigue disponible:
STT_PROVIDER=              # deepgram (opcional, solo si no usas Azure ni Gemini)
DEEPGRAM_API_KEY=
FFMPEG_PATH=               # opcional; por defecto "ffmpeg" (Mac: brew install ffmpeg)
TTS_PROVIDER=client        # client | elevenlabs | azure

# --- Mobile App (apps/mobile) ---
# En desarrollo la app detecta sola la IP del Mac. Para la app instalada en los celulares,
# pon aquí la URL del servidor en la nube (y en eas.json → env al compilar):
# EXPO_PUBLIC_API_URL=https://lingopulse-api-xxxx.us-central1.run.app
EXPO_PUBLIC_APP_KEY=       # la misma que APP_ACCESS_KEY
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
